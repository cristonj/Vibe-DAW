rules_version = '2';

// Every document lives under users/{uid}. A signed-in user can only touch their own tree.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/projects/{projectId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'updatedAt', 'bpm', 'data', 'schemaVersion'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.data is string && request.resource.data.data.size() < 950000;
    }

    match /users/{uid}/samples/{sampleId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && request.resource.data.id == sampleId;
    }

    // AI settings (including the user's Gemini key), appearance and shortcuts.
    // Each section is { data: JSON string, updatedAt: number }.
    match /users/{uid}/prefs/{prefId} {
      function validSection(d, k) {
        return !(k in d) || (d[k] is map
          && d[k].keys().hasOnly(['data', 'updatedAt'])
          && d[k].data is string && d[k].data.size() < 20000
          && d[k].updatedAt is number);
      }
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && prefId == 'main'
        && request.resource.data.keys().hasOnly(['ai', 'appearance', 'keymap'])
        && validSection(request.resource.data, 'ai')
        && validSection(request.resource.data, 'appearance')
        && validSection(request.resource.data, 'keymap');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
